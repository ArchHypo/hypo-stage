{
  "buildCommand": "yarn install --ignore-engines && yarn vercel-build",
  "outputDirectory": "hypo-stage/dist-standalone",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hypo-stage.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
